			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"PONY_ENGINE_LOG_LEVEL": "Error",
				"PONY_ENGINE_LOG_STACKTRACE_LEVEL": "Fatal",
				"PONY_MAKE_GROUPS": false
			}
		},
		{
			"name": "Runtime-Console",
