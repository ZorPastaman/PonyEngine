		},
		{
			"name": "Runtime-Desktop",
			"inherits": "Runtime-GUI",
			"hidden": true,
			"cacheVariables": {
				"PONY_ENGINE_RAW_INPUT_KEYBOARD_IMPL": true,
				"PONY_ENGINE_RAW_INPUT_MOUSE_IMPL": true,
				"PONY_ENGINE_RAW_INPUT_KEYBOARD_ORDER": "rik",
				"PONY_ENGINE_RAW_INPUT_MOUSE_ORDER": "rim"
			}
		},
		{
			"name": "Runtime-Windows",
			"hidden": true
		},
		{
			"name": "Runtime-Windows-GUI",
			"inherits": [ "Runtime-Desktop", "Runtime-Windows" ],
			"hidden": true,
			"cacheVariables": {
				"PONY_ENGINE_APPLICATION_MODE": "GUI",
				"PONY_ENGINE_RENDER_DEVICE_D3D12_IMPL": false,
				"PONY_ENGINE_WINAPI_INPUT": true,
				"PONY_ENGINE_WINAPI_INPUT_IMPL": true,
				"PONY_ENGINE_RAW_INPUT_XINPUT_IMPL": true,
				"PONY_ENGINE_RENDER_DEVICE_D3D12_ORDER": "rdd",
				"PONY_ENGINE_WINAPI_INPUT_ORDER": "qa",
				"PONY_ENGINE_RAW_INPUT_XINPUT_ORDER": "rix"
