{
	"version": 9,
	"configurePresets": [
		{
			"name": "Base",
			"hidden": true,
			"binaryDir": "${sourceDir}/Build/${presetName}",
			"installDir": "${sourceDir}/Install/${presetName}",
			"cacheVariables": {
				"PONY_TOOLS_INSTALL_DIR": "${sourceDir}/Install/Tools"
			}
		},
		{
			"name": "Runtime",
			"inherits": "Base",
			"hidden": true,
			"cacheVariables": {
				"PONY_BUILD_MODE": "Runtime",
				"PONY_ENGINE_CORE": true,
				"PONY_ENGINE_APPLICATION": true,
				"PONY_ENGINE_APPLICATION_IMPL": true,
				"PONY_ENGINE_LOG": true,
				"PONY_ENGINE_LOG_EXT": true,
				"PONY_ENGINE_LOG_IMPL": true,
				"PONY_ENGINE_LOG_CONSOLE_IMPL": true,
				"PONY_ENGINE_LOG_PCONSOLE_IMPL": true,
				"PONY_ENGINE_LOG_FILE_IMPL": true,
				"PONY_ENGINE_TIME": true,
				"PONY_ENGINE_TIME_IMPL": true,
				"PONY_ENGINE_JOB": true,
				"PONY_ENGINE_JOB_IMPL": true,
				"PONY_ENGINE_FILE": true,
				"PONY_ENGINE_FILE_IMPL": true,
				"PONY_ENGINE_RESOURCE": true,
				"PONY_ENGINE_RESOURCE_EXT": true,
				"PONY_ENGINE_RESOURCE_IMPL": false,
				"PONY_ENGINE_RESOURCE_PACK_IMPL": false,
				"PONY_ENGINE_WORLD": true,
				"PONY_ENGINE_WORLD_IMPL": true,
				"PONY_ENGINE_LOG_ORDER": "b",
				"PONY_ENGINE_LOG_CONSOLE_ORDER": "c",
				"PONY_ENGINE_LOG_PCONSOLE_ORDER": "d",
				"PONY_ENGINE_LOG_FILE_ORDER": "f",
				"PONY_ENGINE_TIME_ORDER": "ba",
				"PONY_ENGINE_JOB_ORDER": "ca",
				"PONY_ENGINE_FILE_ORDER": "fa",
				"PONY_ENGINE_RESOURCE_ORDER": "fb",
				"PONY_ENGINE_RESOURCE_FILE_ORDER": "ff",
				"PONY_ENGINE_RESOURCE_PACK_ORDER": "fp",
				"PONY_ENGINE_WORLD_ORDER": "wa",
				"PONY_ENGINE_TIME_TICK_ORDER": "-500000",
				"PONY_ENGINE_RESOURCE_TICK_ORDER": "-100",
				"PONY_ENGINE_TESTING": false,
				"PONY_ENGINE_TESTING_BENCHMARK": false
			}
		},
		{
			"name": "Runtime-Debug",
			"inherits": "Runtime",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"PONY_ENGINE_LOG_LEVEL": "Debug",
				"PONY_ENGINE_LOG_STACKTRACE_LEVEL": "Error",
				"PONY_MAKE_GROUPS": true
			}
		},
		{
			"name": "Runtime-Optimized",
			"inherits": "Runtime",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"PONY_ENGINE_LOG_LEVEL": "Info",
				"PONY_ENGINE_LOG_STACKTRACE_LEVEL": "Fatal",
				"PONY_MAKE_GROUPS": false
			}
		},
		{
			"name": "Runtime-Release",
			"inherits": "Runtime",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"PONY_ENGINE_LOG_LEVEL": "Warning",
				"PONY_ENGINE_LOG_STACKTRACE_LEVEL": "Fatal",
				"PONY_MAKE_GROUPS": false
			}
		},
		{
			"name": "Runtime-Shipping",
